# Copy to .env.local for local development, including `docker compose up`.
#
# In Azure, none of these are set by hand: the non-secret ones come from
# Terraform, and the secret ones are Key Vault references resolved at runtime by
# a managed identity. This file exists for local work only.

# ─── Identity and database (Supabase, phase 1) ─────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Shared cache ──────────────────────────────────────────
# Unset, both backends fall back to in-process memory — correct for one
# replica, silently wrong for several. docker compose sets this for you.
REDIS_URL=redis://localhost:6379

# ─── AI backend ────────────────────────────────────────────
FASTAPI_URL=http://localhost:8000
OPENAI_API_KEY=
# Model routing: the fast model serves the nodes whose output no one reads.
OPENAI_MODEL=gpt-6-luna
OPENAI_MODEL_FAST=gpt-6-luna
ANTHROPIC_API_KEY=

# ─── DHIS2 / SNIS RDC ──────────────────────────────────────
DHIS2_BASE_URL=https://snisrdc.com
DHIS2_USERNAME=
DHIS2_PASSWORD=
DHIS2_ROOT_OU=ymGeqzoPhN3

# In-process scheduling is fine locally; in Azure the ETL is a cron Job and
# this is forced to false so replicas do not each sync in parallel.
ETL_SCHEDULER_ENABLED=true

# ─── Settings encryption ───────────────────────────────────
# REQUIRED. Without it the application derives the key from
# SUPABASE_SERVICE_ROLE_KEY, so rotating that key would make every stored
# setting permanently undecryptable (SEC-09).
#   openssl rand -base64 48
APP_SETTINGS_ENCRYPTION_KEY=

# ─── Notifications ─────────────────────────────────────────
# REQUIRED to send push/e-mail. There is no fallback value any more: the
# previous default was published in this repository (SEC-02).
#   openssl rand -base64 36
PUSH_INTERNAL_TOKEN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RESEND_API_KEY=

# ─── Voice input ───────────────────────────────────────────
ELEVENLABS_API_KEY=

# ─── Static assets ─────────────────────────────────────────
# Empty serves them from /public; in Azure this points at Blob Storage.
NEXT_PUBLIC_ASSETS_URL=

# ─── Observability ─────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ─── Power BI (optional) ───────────────────────────────────
# Transitional: public "Publish to web" link rendered in a plain iframe.
# Empty = built-in default link; "off" = use Power BI Embedded (Azure) below.
NEXT_PUBLIC_POWERBI_PUBLIC_URL=
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=
POWERBI_DATASET_ID=
