variable "name" {
  description = "Server name."
  type        = string
}

variable "resource_group_name" {
  description = "Resource group."
  type        = string
}

variable "location" {
  description = "Azure region."
  type        = string
}

variable "tenant_id" {
  description = "Entra tenant id."
  type        = string
}

variable "tags" {
  description = "Tags applied to every resource."
  type        = map(string)
}

variable "postgres_version" {
  description = "Major version."
  type        = string
  default     = "16"
}

variable "sku_name" {
  description = "Compute tier. B1ms for dev, D2ds_v5 and up for prod."
  type        = string
  default     = "B_Standard_B1ms"
}

variable "storage_mb" {
  description = "Allocated storage in MB."
  type        = number
  default     = 32768
}

variable "administrator_login" {
  description = "Break-glass administrator login. Day-to-day access uses Entra."
  type        = string
  default     = "diav1admin"
}

variable "administrator_password" {
  description = "Generated by the keyvault module — no human ever types it."
  type        = string
  sensitive   = true
}

variable "database_name" {
  description = "Application database."
  type        = string
  default     = "diav1"
}

variable "delegated_subnet_id" {
  description = "Subnet delegated to Microsoft.DBforPostgreSQL/flexibleServers."
  type        = string
}

variable "private_dns_zone_id" {
  description = "privatelink.postgres.database.azure.com zone id."
  type        = string
}

variable "backup_retention_days" {
  description = "Point-in-time restore window."
  type        = number
  default     = 7

  validation {
    condition     = var.backup_retention_days >= 7 && var.backup_retention_days <= 35
    error_message = "backup_retention_days must be between 7 and 35."
  }
}

variable "geo_redundant_backup" {
  description = "Replicate backups to the paired region. Prod only — it doubles backup cost."
  type        = bool
  default     = false
}

variable "high_availability" {
  description = "Zone-redundant standby. Roughly doubles compute cost, so prod only."
  type        = bool
  default     = false
}

variable "availability_zone" {
  description = "Primary zone."
  type        = string
  default     = "1"
}

variable "standby_availability_zone" {
  description = "Standby zone, when high availability is enabled."
  type        = string
  default     = "2"
}

variable "entra_administrators" {
  description = "Principal name → object id, granted Entra administrator on the server."
  type        = map(string)
  default     = {}
}

variable "log_analytics_workspace_id" {
  description = "Workspace receiving server logs. Empty disables diagnostics."
  type        = string
  default     = ""
}

variable "enable_diagnostics" {
  description = "Send diagnostics to Log Analytics. A plan-time boolean, not a check on the computed workspace id."
  type        = bool
  default     = true
}
